@model RaceDay.MVC.Models.CategoryCreateViewModel

@{
    ViewData["Title"] = "Create Event Category";
}

<div class="container mt-4">

    <h2>Create Event Category</h2>

    <form asp-controller="Organiser"
          asp-action="CreateCategory"
          method="post">

        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="CategoryName" class="form-label">Category Name</label>
            <input asp-for="CategoryName" class="form-control" placeholder="e.g. 10KM Open" />
            <span asp-validation-for="CategoryName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="MinAge" class="form-label">Minimum Age</label>
            <input asp-for="MinAge" type="number" class="form-control" />
            <span asp-validation-for="MinAge" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="MaxAge" class="form-label">Maximum Age</label>
            <input asp-for="MaxAge" type="number" class="form-control" />
            <span asp-validation-for="MaxAge" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Distance" class="form-label">Distance (KM)</label>
            <input asp-for="Distance" type="number" step="0.1" class="form-control" />
            <span asp-validation-for="Distance" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="EventId" class="form-label">Select Event</label>
            <select asp-for="EventId"
                    asp-items="ViewBag.Events"
                    class="form-control">
                <option value="">-- Select Event --</option>
            </select>
            <span asp-validation-for="EventId" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Create Category
        </button>

        <a asp-controller="Organiser"
           asp-action="Dashboard"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>