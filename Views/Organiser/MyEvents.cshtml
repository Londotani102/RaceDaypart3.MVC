@model IEnumerable<RaceDay.MVC.Models.EventViewModel>

@{
    ViewData["Title"] = "My Events";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Events</h2>

        <a asp-controller="Organiser"
           asp-action="Create"
           class="btn btn-primary">
            + Create Event
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Event Name</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Event Type</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var ev in Model)
                    {
                        <tr>
                            <td>@ev.EventName</td>

                            <td>@ev.EventDate.ToString("dd MMM yyyy HH:mm")</td>

                            <td>@ev.Location</td>

                            <td>@ev.EventType</td>

                            <td>
                                <div class="d-flex gap-2">

                                    <a asp-controller="Organiser"
                                       asp-action="Edit"
                                       asp-route-id="@ev.EventId"
                                       class="btn btn-sm btn-warning">
                                        Edit
                                    </a>

                                    <form asp-controller="Organiser"
                                          asp-action="Delete"
                                          asp-route-id="@ev.EventId"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to delete this event?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-danger">
                                            Delete
                                        </button>
                                    </form>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            You have no events to display yet.
        </div>
    }

    <a asp-controller="Organiser"
       asp-action="Dashboard"
       class="btn btn-secondary mt-3">
        Back to Dashboard
    </a>

</div>