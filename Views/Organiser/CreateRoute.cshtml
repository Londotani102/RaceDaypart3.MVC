@model RaceDay.MVC.Models.RouteCreateViewModel

@{
    ViewData["Title"] = "Create Route";
}

<div class="container mt-5">
    <h2>Create Race Route</h2>

    <form asp-controller="Organiser"
          asp-action="CreateRoute"
          method="post">

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="RouteName">Route Name</label>
            <input asp-for="RouteName" class="form-control" />
            <span asp-validation-for="RouteName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description">Description</label>
            <textarea asp-for="Description" class="form-control"></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="Distance">Distance (KM)</label>
            <input asp-for="Distance" type="number"
                   step="0.1" class="form-control" />
            <span asp-validation-for="Distance" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="StartLocation">Start Location</label>
            <input asp-for="StartLocation" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="EndLocation">End Location</label>
            <input asp-for="EndLocation" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="RouteMapUrl">Route Map URL</label>
            <input asp-for="RouteMapUrl" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary">
            Save Route
        </button>

        <a asp-controller="Organiser"
           asp-action="Dashboard"
           class="btn btn-secondary">Cancel</a>
    </form>
</div>
