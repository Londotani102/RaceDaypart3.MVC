@model RaceDay.MVC.Models.ResultCreateViewModel

@{
    ViewData["Title"] = "Record Race Result";
}

<h2>Record Race Result</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<form asp-controller="Results" asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="EventEnrollmentId" class="form-label">
            Enrolment ID
        </label>
        <input asp-for="EventEnrollmentId" class="form-control" />
        <span asp-validation-for="EventEnrollmentId"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="FinishTime" class="form-label">
            Finishing Time (hh:mm:ss)
        </label>
        <input asp-for="FinishTime"
               type="text"
               class="form-control"
               placeholder="01:30:00" />
        <span asp-validation-for="FinishTime"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Position" class="form-label">
            Finishing Position
        </label>
        <input asp-for="Position" type="number" class="form-control" />
        <span asp-validation-for="Position"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Save Result
    </button>

    <a asp-controller="Results"
       asp-action="Index"
       class="btn btn-secondary">View Results</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}