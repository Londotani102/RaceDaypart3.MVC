@model List<RaceDay.MVC.Models.EventViewModel>

@{
    ViewData["Title"] = "Available Events";
}

<div class="container mt-4">

    <h2 class="mb-4">Available Race Events</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No events are currently available.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            <h5 class="card-title">
                                @item.EventName
                            </h5>

                            <p class="card-text">
                                <strong>Location:</strong>
                                @item.Location
                            </p>

                            <p class="card-text">
                                <strong>Date:</strong>
                                @item.EventDate.ToString("dd MMMM yyyy")
                            </p>

                            <p class="card-text">
                                <strong>Description:</strong>
                                @item.Description
                            </p>

                            <a asp-controller="Participant"
                               asp-action="Enrol"
                               asp-route-eventId="@item.EventId"
                               class="btn btn-primary">
                                Enrol Now
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

    <a asp-controller="Participant"
       asp-action="Dashboard"
       class="btn btn-secondary mt-3">
        Back to Dashboard
    </a>

</div>